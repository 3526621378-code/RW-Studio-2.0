[Unit]
Description=RW Studio Next.js website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rwstudio
Group=rwstudio
WorkingDirectory=/opt/rw-studio
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
EnvironmentFile=-/etc/rw-studio.env
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/rw-studio/.next/cache
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
